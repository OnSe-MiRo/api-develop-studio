{
  "defaults": {
    "retry": 0,
    "retry_interval_seconds": 0
  },
  "project": "example-api.json",
  "steps": [
    {
      "case": "example/users/create_user.json",
      "name": "create_user"
    },
    {
      "case": "example/users/get_user.json",
      "input_mappings": [
        {
          "response_path": "body.id",
          "source_step": "create_user",
          "target": "url",
          "template": "/example-api/users/{{value}}"
        }
      ],
      "name": "get_user"
    }
  ]
}
