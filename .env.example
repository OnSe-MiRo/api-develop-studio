# Copy this file to .env and replace the values required by your network.
API_PORT=8765
WEB_PORT=5173

# Set true to expose the built-in example API and its example project, cases, and pipeline in the web UI.
EXAMPLE_PROJECT=true

# Only used when running the API directly outside Docker. Docker Compose uses the encryption service instead.
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_TEST_ENCRYPTION_KEY=

# Host directories mounted into the API container.
CASE_VOLUME_PATH=./case
LOG_VOLUME_PATH=./logs
PROJECT_VOLUME_PATH=./projects
DATA_VOLUME_PATH=./data

# Network proxy used by the running Python API tester and during image builds.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,api,web

# Python package installation (pip). Set PIP_TRUSTED_HOST to your internal package host when required.
PIP_PROXY=
PIP_TRUSTED_HOST=
PIP_INDEX_URL=
PIP_EXTRA_INDEX_URL=

# Node package installation (npm). npm uses HTTP_PROXY and HTTPS_PROXY above.
# Use your internal registry if applicable.
NPM_REGISTRY=https://registry.npmjs.org/
NPM_STRICT_SSL=true
