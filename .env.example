# Copy this file to .env and replace the values required by your network.
API_PORT=8765
WEB_PORT=5173

# Both must be true to bypass ownership verification. Defaults are fail-closed.
# LOCAL_SERVER=true requires native loopback binding; Docker uses server mode.
# Native defaults to STUDIO_AUTH_MODE=local; Compose explicitly uses remote.
# Remote data APIs require a verified CurrentUser adapter (COL-1).
LOCAL_SERVER=false
SKIP_OWNERSHIP_VERIFICATION=false
# Server mode only: at least 32 characters, required to approve external setup calls.
STUDIO_APPROVER_KEY=

# RUN-2: single API process; limits include queued and running jobs.
RUN_WORKERS=2
RUN_CAPACITY=20
RUN_USER_LIMIT=10
RUN_PROJECT_LIMIT=10
RUN_TIMEOUT_SECONDS=300
RUN_RETENTION=600
RUN_MAX_COMPLETED=100

# Set true to expose the built-in example API and its example project, cases, and pipeline in the web UI.
EXAMPLE_PROJECT=true

# Only used when running the API directly outside Docker. Docker Compose uses the encryption service instead.
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_TEST_ENCRYPTION_KEY=

# Host directories mounted into the API container.
CASE_VOLUME_PATH=./case
LOG_VOLUME_PATH=./logs
PROJECT_VOLUME_PATH=./projects
DATA_VOLUME_PATH=./data

# Network proxy used by the running Python API tester and during image builds.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,api,web,postgres,redis

# Python package installation (pip). Set PIP_TRUSTED_HOST to your internal package host when required.
PIP_PROXY=
PIP_TRUSTED_HOST=
PIP_INDEX_URL=
PIP_EXTRA_INDEX_URL=

# Node package installation (npm). npm uses HTTP_PROXY and HTTPS_PROXY above.
# Use your internal registry if applicable.
NPM_REGISTRY=https://registry.npmjs.org/
NPM_STRICT_SSL=true

# Docker PostgreSQL credentials. Replace the local development password before shared or production use.
POSTGRES_DB=studio
POSTGRES_USER=studio
POSTGRES_PASSWORD=change-this-local-password
STUDIO_ENV=local
# Native development without STUDIO_DATABASE_URL continues to use SQLite compatibility mode.
# Redis is optional outside Docker; e.g. redis://127.0.0.1:6379/0
STUDIO_REDIS_URL=

# COL-1: Native defaults to local; Compose uses remote and never permits anonymous data access.
# Register this exact callback: ${STUDIO_PUBLIC_URL}/auth/callback
STUDIO_PUBLIC_URL=https://studio.example.com
STUDIO_OIDC_ISSUER=
STUDIO_OIDC_CLIENT_ID=
STUDIO_OIDC_CLIENT_SECRET=
# Prefer *_FILE secret mounts for client secret and session key in production.
STUDIO_OIDC_AUTH_METHOD=client_secret_basic
# Fernet key; generate once and keep stable across restarts. Rotation invalidates sessions.
STUDIO_SESSION_KEY=
STUDIO_SESSION_IDLE_SECONDS=1800
STUDIO_SESSION_MAX_SECONDS=28800
# Space-separated exact extra endpoint origins, e.g. a separate trusted token/JWKS host.
STUDIO_OIDC_ENDPOINT_ORIGINS=
STUDIO_OIDC_PRIVATE_ORIGINS=
STUDIO_OIDC_CA_FILE=
STUDIO_OIDC_ALLOW_LOOPBACK_HTTP=false
