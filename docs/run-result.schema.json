{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API Develop Studio Run Report v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string"
    },
    "environment": {
      "type": [
        "string",
        "null"
      ]
    },
    "actor": {
      "type": [
        "string",
        "null"
      ]
    },
    "appVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "error",
        "timeout",
        "cancelled"
      ]
    },
    "exitCode": {
      "enum": [
        0,
        1,
        2
      ]
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target": {
            "type": "string"
          },
          "caseId": {
            "type": "string"
          },
          "project": {
            "type": [
              "string",
              "null"
            ]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "error",
              "timeout",
              "cancelled"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "httpStatus": {
            "type": [
              "integer",
              "null"
            ]
          },
          "elapsedMs": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "errorCategory": {
            "enum": [
              null,
              "request_error",
              "request_timeout",
              "assertion_failed",
              "configuration_error"
            ]
          },
          "assertions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 0
                },
                "passed": {
                  "type": "boolean"
                }
              },
              "required": [
                "index",
                "passed"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "target",
          "caseId",
          "project",
          "startedAt",
          "finishedAt",
          "status",
          "attempts",
          "httpStatus",
          "elapsedMs",
          "errorCategory",
          "assertions"
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "format": {
            "enum": [
              "json",
              "junit"
            ]
          },
          "reference": {
            "type": "string"
          }
        },
        "required": [
          "format",
          "reference"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "environment",
    "actor",
    "appVersion",
    "commit",
    "startedAt",
    "finishedAt",
    "status",
    "exitCode",
    "targets",
    "artifacts"
  ],
  "additionalProperties": false
}
